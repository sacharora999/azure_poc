
function generateFormattedReport(
  workbook: ExcelScript.Workbook,
  sheetName: string,
  reportName: string,
  reportDate: string,
  headers: string[],
  output: (string | number)[][]
): void {

  // Corporate theme colors
  const BURGUNDY = "#A51D2D";
  const DARK = "#28323C";
  const WHITE = "#FFFFFF";
  const LIGHT = "#F3F5F7";
  const GREY = "#68717B";

  if (headers.length === 0) {
    throw new Error("Headers cannot be empty.");
  }

  const columnCount = headers.length;
  const brandingWidth = Math.max(columnCount, 4);

  // Create the report worksheet
  let sheet = workbook.getWorksheet(sheetName);

  if (sheet) sheet.delete();
  sheet = workbook.addWorksheet(sheetName);

  // Combine headers and output
  const finalOutput: (string | number)[][] = [
    [...headers],
    ...output.map(row => {
      if (row.length > columnCount) {
        throw new Error("Data row has too many columns.");
      }

      return [
        ...row,
        ...Array<string>(
          columnCount - row.length
        ).fill("")
      ];
    })
  ];

  // Branding section: rows 1–5
  const top = sheet.getRangeByIndexes(
    0, 0, 5, brandingWidth
  );
  top.getFormat().getFill().setColor(WHITE);

  // Company name
  const company = sheet.getRangeByIndexes(
    0, 0, 1, brandingWidth
  );
  company.merge();
  company.setValue("METAL ONE CORPORATION");

  const companyFont = company.getFormat().getFont();
  companyFont.setName("Aptos");
  companyFont.setSize(12);
  companyFont.setBold(true);
  companyFont.setColor(BURGUNDY);

  // Report title - italic
  const title = sheet.getRangeByIndexes(
    1, 0, 1, brandingWidth
  );
  title.merge();
  title.setValue(reportName);

  const titleFont = title.getFormat().getFont();
  titleFont.setName("Aptos Display");
  titleFont.setSize(20);
  titleFont.setBold(true);
  titleFont.setItalic(true);
  titleFont.setColor(DARK);

  // Report date - italic
  const dateRange = sheet.getRangeByIndexes(
    2, 0, 1, brandingWidth
  );
  dateRange.merge();
  dateRange.setValue("As of " + reportDate);

  const dateFont = dateRange.getFormat().getFont();
  dateFont.setName("Aptos");
  dateFont.setSize(11);
  dateFont.setItalic(true);
  dateFont.setColor(GREY);

  // Accent bar
  sheet.getRangeByIndexes(
    4, 0, 1, brandingWidth
  ).getFormat().getFill().setColor(BURGUNDY);

  // Write report from Excel row 7
  const reportRange = sheet.getRangeByIndexes(
    6, 0, finalOutput.length, columnCount
  );
  reportRange.setValues(finalOutput);

  // Base table font
  const tableFont = reportRange.getFormat().getFont();
  tableFont.setName("Aptos");
  tableFont.setSize(10);
  tableFont.setColor(DARK);

  // Table headers
  const headerRange = sheet.getRangeByIndexes(
    6, 0, 1, columnCount
  );
  headerRange.getFormat().getFill().setColor(DARK);

  const headerFont = headerRange.getFormat().getFont();
  headerFont.setBold(true);
  headerFont.setColor(WHITE);
  headerFont.setSize(11);

  headerRange.getFormat().setRowHeight(34);

  // Alternating row colors
  for (let i = 1; i < finalOutput.length; i++) {
    if (i % 2 === 0) {
      sheet.getRangeByIndexes(
        6 + i, 0, 1, columnCount
      ).getFormat().getFill().setColor(LIGHT);
    }
  }

  // Adjust columns and freeze headers
  reportRange.getFormat().autofitColumns();
  sheet.getFreezePanes().freezeRows(7);

  console.log("Report created: " + sheetName);
}
