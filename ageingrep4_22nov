
/**
 * INVENTORY AGEING REPORT
 * ----------------------------------------------------------
 * Input worksheets:
 *   1. MB51
 *   2. MB52
 *   3. Previous Ageing
 *   4. Plant Master
 *
 * Output worksheets:
 *   1. Ageing Sheet
 *   2. Adjusted MB52
 *   3. Movement Audit
 *
 * Processing:
 *   - Identify backdated 101/601 movements.
 *   - Adjust stock values for 601-only movements.
 *   - Append backdated 101 movements according to existing logic.
 *   - Determine GR dates and ageing days.
 *   - Calculate amount and quantity ageing buckets.
 *   - Generate formatted Excel output.
 *
 * Report date format: YYYY-MM-DD
 */

function main(
    workbook: ExcelScript.Workbook,
    reportDate: string = "2026-10-31"
) {

    // =========================================================
    // SECTION 1: DEFINE TYPES
    // =========================================================

    type Cell = string | number | boolean;

    type RecordRow = {
        [key: string]: Cell;
    };

    type BackdatedMovement = {
        postingDate: string;
        quantity: number;
        bun: string;
    };

    // =========================================================
    // SECTION 2: VALIDATE INPUT WORKSHEETS
    // =========================================================

    const required = [
        "MB51",
        "MB52",
        "Previous Ageing",
        "Plant Master"
    ];

    for (const name of required) {
        if (!workbook.getWorksheet(name)) {
            throw new Error(`Missing worksheet: ${name}`);
        }
    }

    // =========================================================
    // SECTION 3: READ EXCEL DATA
    // =========================================================

    function rows(name: string): RecordRow[] {

        const sheet = workbook.getWorksheet(name);
        const used = sheet.getUsedRange();

        if (!used) {
            throw new Error(`Empty worksheet: ${name}`);
        }

        const values = used.getValues() as Cell[][];

        const headers = values[0].map(
            v => String(v).trim()
        );

        return values
            .slice(1)
            .filter(r =>
                r.some(v =>
                    String(v ?? "").trim() !== ""
                )
            )
            .map(r => {

                const obj: RecordRow = {};

                headers.forEach((h, i) => {
                    obj[h] = r[i] ?? "";
                });

                return obj;
            });
    }

    // =========================================================
    // SECTION 4: HELPER FUNCTIONS
    // =========================================================

    // Convert a cell value to a trimmed string.
    const s = (
        v: Cell | undefined
    ): string => String(v ?? "").trim();

    // Convert a cell value to a number.
    const n = (
        v: Cell | undefined
    ): number => {

        const x = Number(
            String(v ?? "").replace(/,/g, "")
        );

        return Number.isFinite(x) ? x : 0;
    };

    // Material and batch form the movement lookup key.
    const key = (r: RecordRow): string =>
        `${s(r["Material"])}|${s(r["Batch"])}`;

    // Return the first available field from a list of
    // alternative headers. This supports MB52 short headers.
    function field(
        r: RecordRow,
        names: string[]
    ): Cell | undefined {

        for (const name of names) {
            const value = r[name];

            if (
                value !== undefined &&
                String(value).trim() !== ""
            ) {
                return value;
            }
        }

        return undefined;
    }

    // =========================================================
    // SECTION 5: DATE CONVERSION
    // =========================================================

    function iso(
        v: Cell | undefined
    ): string {

        // Excel date serial.
        if (typeof v === "number") {

            const d = new Date(
                Date.UTC(1899, 11, 30) +
                v * 86400000
            );

            return d.toISOString().slice(0, 10);
        }

        const t = s(v);

        // YYYY-MM-DD
        if (/^\d{4}-\d{2}-\d{2}$/.test(t)) {
            return t;
        }

        // DD-Mon-YY or DD-Mon-YYYY
        if (/^\d{2}-[A-Za-z]{3}-\d{2,4}$/.test(t)) {

            const parts = t.split("-");

            const mon = [
                "jan", "feb", "mar", "apr",
                "may", "jun", "jul", "aug",
                "sep", "oct", "nov", "dec"
            ].indexOf(parts[1].toLowerCase());

            const yr = Number(parts[2]);

            if (mon >= 0) {

                const year =
                    yr < 100 ? 2000 + yr : yr;

                return (
                    `${year}-` +
                    `${String(mon + 1).padStart(2, "0")}-` +
                    `${parts[0]}`
                );
            }
        }

        return "";
    }

    // =========================================================
    // SECTION 6: REPORT DATE
    // =========================================================

    if (!/^\d{4}-\d{2}-\d{2}$/.test(reportDate)) {
        throw new Error(
            "reportDate must be YYYY-MM-DD"
        );
    }

    const reportMs = Date.parse(
        reportDate + "T00:00:00Z"
    );

    if (!Number.isFinite(reportMs)) {
        throw new Error("Invalid reportDate");
    }

    const reportMonth = reportDate.slice(0, 7);

    const prevLast = new Date(
        Date.UTC(
            Number(reportDate.slice(0, 4)),
            Number(reportDate.slice(5, 7)) - 1,
            0
        )
    );

    const prevMonth = prevLast
        .toISOString()
        .slice(0, 7);

    // =========================================================
    // SECTION 7: LOAD SOURCE DATA
    // =========================================================

    const mb51 = rows("MB51");
    const mb52 = rows("MB52");
    const previous = rows("Previous Ageing");
    const master = rows("Plant Master");

    // =========================================================
    // SECTION 8: BUILD PLANT MASTER LOOKUP
    // =========================================================

    const plant = new Map<string, RecordRow>();

    master.forEach(r => {
        plant.set(s(r["Plant"]), r);
    });

    // Preserve the batch lookup from the original script.
    const batch = new Map<string, RecordRow>();

    master.forEach(r => {
        batch.set(s(r["Batch"]), r);
    });

    // =========================================================
    // SECTION 9: PREVIOUS AGEING GR DATE
    // =========================================================

    const previousGR = new Map<string, string>();

    previous.forEach(r => {

        const d = iso(r["GR Date"]);
        const k = key(r);

        if (
            d &&
            (
                !previousGR.has(k) ||
                d < (previousGR.get(k) || "")
            )
        ) {
            previousGR.set(k, d);
        }
    });

    // =========================================================
    // SECTION 10: GROUP MB51 MOVEMENTS
    // =========================================================

    const movements =
        new Map<string, RecordRow[]>();

    mb51.forEach(r => {

        const k = key(r);

        const a = movements.get(k) || [];

        a.push(r);

        movements.set(k, a);
    });

    // =========================================================
    // SECTION 11: ADJUST MB52 STOCK
    // =========================================================

    const adjusted: RecordRow[] = [];

    const audit: (string | number)[][] = [];

    const existing = new Set(
        mb52.map(r => key(r))
    );

    for (const stock of mb52) {

        const k = key(stock);

        // Find movements posted in the previous month
        // but entered during the reporting month.
        const backdated = (
            movements.get(k) || []
        ).filter(r =>

            iso(r["Posting Date"]).slice(0, 7)
                === prevMonth &&

            iso(r["Entry Date"]).slice(0, 7)
                === reportMonth
        );

        const types = new Set(
            backdated.map(r =>
                s(r["Movement Type"])
            )
        );

        // -----------------------------------------------------
        // CASE 1: BACKDATED 601 ONLY
        // -----------------------------------------------------

        if (
            types.size === 1 &&
            types.has("601")
        ) {

            const originalValue = n(
                stock["Value Unrestricted"]
            );

            const deduction = backdated.reduce(
                (sum, r) =>
                    sum +
                    Math.abs(
                        n(r["Amt.in Loc.Cur."])
                    ),
                0
            );

            const updatedValue =
                originalValue - deduction;

            const updatedStock: RecordRow = {
                ...stock,
                "Value Unrestricted": updatedValue
            };

            adjusted.push(updatedStock);

            audit.push([
                k,
                "Deduct 601 from MB52",
                `Original: ${originalValue}, ` +
                `Deduction: ${deduction}, ` +
                `Final: ${updatedValue}`
            ]);

            continue;
        }

        // -----------------------------------------------------
        // CASE 2: KEEP ORIGINAL MB52
        // -----------------------------------------------------

        adjusted.push(stock);

        if (
            types.size === 1 &&
            types.has("101")
        ) {

            audit.push([
                k,
                "KEEP MB52",
                "101 only; already in MB52, no duplicate appended"
            ]);

        } else if (
            types.has("101") &&
            types.has("601")
        ) {

            audit.push([
                k,
                "KEEP MB52",
                "Mixed 101 and 601; no transfer"
            ]);
        }
    }

    // =========================================================
    // SECTION 12: APPEND BACKDATED 101 MOVEMENTS
    // =========================================================
    //
    // Retains the active logic from the screenshots:
    // append individual backdated 101 records when the
    // movement type set contains only 101.
    //
    // Note: The original active implementation does not
    // skip material/batch keys already present in MB52.

    for (
        const [k, all]
        of Array.from(movements.entries())
    ) {

        const backdated = all.filter(r =>

            iso(r["Posting Date"]).slice(0, 7)
                === prevMonth &&

            iso(r["Entry Date"]).slice(0, 7)
                === reportMonth
        );

        const types = new Set(
            backdated.map(r =>
                s(r["Movement Type"])
            )
        );

        if (
            types.size !== 1 ||
            !types.has("101")
        ) {
            continue;
        }

        for (const r of backdated) {

            adjusted.push({

                "Material": r["Material"],

                "Plant": r["Plant"],

                "Material Description":
                    r["Material Description"],

                "Storage Location":
                    r["Storage Location"],

                "Batch": r["Batch"],

                "Base Unit": r["Unit"],

                "Unrestricted Qty":
                    n(r["Quantity"]),

                "Currency": "INR",

                "Value Unrestricted":
                    n(r["Amt.in Loc.Cur."])
            });
        }

        audit.push([
            k,
            "Append MB51 to MB52",
            `Added ${backdated.length} backdated 101 rows`
        ]);
    }

    // =========================================================
    // SECTION 13: GENERATE AGEING REPORT
    // =========================================================

    const output: (string | number)[][] = [];

    for (const r of adjusted) {

        const k = key(r);

        const m = plant.get(
            s(r["Plant"])
        );

        // -----------------------------------------------------
        // 13.1: IDENTIFY BACKDATED 101 RECEIPTS
        // -----------------------------------------------------

        const backdated101: BackdatedMovement[] = (
            movements.get(k) || []
        )
            .filter(x =>

                s(x["Movement Type"]) === "101" &&

                iso(x["Posting Date"]).slice(0, 7)
                    === prevMonth &&

                iso(x["Entry Date"]).slice(0, 7)
                    === reportMonth
            )
            .map(x => ({

                postingDate:
                    iso(x["Posting Date"]),

                quantity:
                    n(x["Quantity"]),

                bun:
                    s(x["Base Unit of Measure"])
            }))
            .filter(x =>
                x.postingDate !== ""
            )
            .sort((a, b) =>
                a.postingDate.localeCompare(
                    b.postingDate
                )
            );

        // -----------------------------------------------------
        // 13.2: FIND ELIGIBLE 101 PURCHASE ORDER RECEIPTS
        // -----------------------------------------------------

        const eligible = (
            movements.get(k) || []
        )
            .filter(x =>

                s(x["Movement Type"]) === "101" &&

                s(x["Purchase Order"])
                    .startsWith("4500")
            )
            .map(x =>
                iso(x["Posting Date"])
            )
            .filter(x =>
                x !== ""
            )
            .sort();

        // -----------------------------------------------------
        // 13.3: DETERMINE GR DATE
        // -----------------------------------------------------

        const gr =
            previousGR.get(k) ||
            backdated101[0]?.postingDate ||
            eligible[0] ||
            "";

        // -----------------------------------------------------
        // 13.4: CALCULATE AGEING DAYS
        // -----------------------------------------------------

        const days = gr
            ? Math.round(
                (
                    reportMs -
                    Date.parse(
                        gr + "T00:00:00Z"
                    )
                ) / 86400000
            )
            : -1;

        // -----------------------------------------------------
        // 13.5: ORIGINAL AGEING BUCKET
        // -----------------------------------------------------

        const bucket =
            days < 0 ? "GR DATE MISSING" :
            days <= 30 ? "0-30" :
            days <= 60 ? "31-60" :
            days <= 90 ? "61-90" :
            days <= 180 ? "91-180" :
            days <= 365 ? "181-365" :
            "over 365";

        // -----------------------------------------------------
        // 13.6: QUANTITY, VALUE AND UNIT
        // -----------------------------------------------------

        const qty =
            n(field(r, [
                "Unrestricted",
                "Unrestricted Qty"
            ])) ||
            backdated101[0]?.quantity ||
            0;

        const val = n(
            r["Value Unrestricted"]
        );

        const baseUnitofMeasure =
            s(field(r, [
                "BUn",
                "Base Unit"
            ])) ||
            backdated101[0]?.bun ||
            "";

        const unitPrice = qty
            ? Math.round(
                val / qty * 100
            ) / 100
            : 0;

        // -----------------------------------------------------
        // SECTION 14: NEW AMOUNT AGEING COLUMNS
        // -----------------------------------------------------
        //
        // 0-6 months       : 0-180 days
        // 6-12 months      : 181-365 days
        // 12-18 months     : 366-548 days
        // 18-24 months     : 549-730 days
        // More than 2 years: >730 days
        //
        // Missing GR date: all ageing amounts remain zero.

        const amount0To6 =
            days >= 0 && days <= 180
                ? val : 0;

        const amount6To12 =
            days > 180 && days <= 365
                ? val : 0;

        const amount12To18 =
            days > 365 && days <= 548
                ? val : 0;

        const amount18To24 =
            days > 548 && days <= 730
                ? val : 0;

        const amountOver24 =
            days > 730
                ? val : 0;

        // -----------------------------------------------------
        // SECTION 15: NEW QUANTITY AGEING COLUMNS
        // -----------------------------------------------------

        const qty0To6 =
            days >= 0 && days <= 180
                ? qty : 0;

        const qty6To12 =
            days > 180 && days <= 365
                ? qty : 0;

        const qty12To18 =
            days > 365 && days <= 548
                ? qty : 0;

        const qty18To24 =
            days > 548 && days <= 730
                ? qty : 0;

        const qtyOver24 =
            days > 730
                ? qty : 0;

        // -----------------------------------------------------
        // SECTION 16: BUILD COMPLETE AGEING OUTPUT ROW
        // -----------------------------------------------------

        output.push([

            // Existing columns A-O
            s(m?.["Plant"]) || "UNMAPPED",
            s(m?.["Customer"]) || "UNMAPPED",
            s(m?.["Branch"]) || "UNMAPPED",
            s(m?.["Warehouse Name"]) || "UNMAPPED",
            s(r["Material"]),
            s(r["Material Description"]),
            s(r["Batch"]),
            gr,
            baseUnitofMeasure,
            qty,
            1,
            qty,
            unitPrice,
            val,
            days >= 0 ? days : "",

            // New amount ageing columns P-T
            amount0To6,
            amount6To12,
            amount12To18,
            amount18To24,
            amountOver24,

            // New quantity ageing columns U-Y
            qty0To6,
            qty6To12,
            qty12To18,
            qty18To24,
            qtyOver24,

            // Existing ageing bucket moved to Z
            bucket
        ]);
    }

    // =========================================================
    // SECTION 17: WRITE FORMATTED OUTPUT WORKSHEETS
    // =========================================================

    function write(
        name: string,
        headers: string[],
        data: (string | number)[][]
    ): void {

        // Remove an earlier generated sheet.
        const old = workbook.getWorksheet(name);

        if (old) {
            old.delete();
        }

        const sh = workbook.addWorksheet(name);

        // Combine headers and report records.
        const matrix: (string | number)[][] = [
            headers,
            ...data
        ];

        sh.getRangeByIndexes(
            0,
            0,
            matrix.length,
            headers.length
        ).setValues(matrix);

        // Format the header row.
        const h = sh.getRangeByIndexes(
            0,
            0,
            1,
            headers.length
        );

        h.getFormat()
            .getFill()
            .setColor("#167D79");

        h.getFormat()
            .getFont()
            .setColor("#FFFFFF");

        h.getFormat()
            .getFont()
            .setBold(true);

        // Keep headers visible while scrolling.
        sh.getFreezePanes().freezeRows(1);

        // Automatically size output columns.
        sh.getUsedRange()
            .getFormat()
            .autofitColumns();

        // Apply consistent row height.
        sh.getRangeByIndexes(
            0,
            0,
            matrix.length,
            headers.length
        )
            .getFormat()
            .setRowHeight(20);
    }

    // =========================================================
    // SECTION 18: GENERATE AGEING SHEET
    // =========================================================

    write(
        "Ageing Sheet",
        [
            // Existing report columns
            "Plant",
            "Customer",
            "Branch",
            "Warehouse Name",
            "Material",
            "Description",
            "Batch",
            "GR Date",
            "UoM",
            "Quantity",
            "Conv Factor",
            "QTY in MT",
            "Unit Price",
            "Value",
            "No. of Days",

            // New amount ageing columns
            "Amt. 0-6 Months",
            "Amt. 6-12 Months",
            "Amt. 1 year to 1 year 6 Month",
            "Amt. 1 year 6 Month to 2 Year",
            "Amt. More than 2 year",

            // New quantity ageing columns
            "QTY 0-6 Months",
            "QTY 6-12 Months",
            "QTY 1 year to 1 year 6 Month",
            "QTY 1 year 6 Month to 2 Year",
            "QTY More than 2 year",

            // Original ageing bucket
            "Age Bucket"
        ],
        output
    );

    // =========================================================
    // SECTION 19: GENERATE ADJUSTED MB52
    // =========================================================

    const adjustedHeaders = [
        "Material",
        "Plant",
        "Material Description",
        "Storage Location",
        "Batch",
        "Base Unit",
        "Unrestricted Qty",
        "Currency",
        "Value Unrestricted"
    ];

    const adjustedOutput: (
        string | number
    )[][] = adjusted.map(
        (r: RecordRow): (string | number)[] => [

            s(r["Material"]),

            s(r["Plant"]),

            s(r["Material Description"]),

            s(field(r, [
                "Loca",
                "Storage Location"
            ])),

            s(r["Batch"]),

            s(field(r, [
                "BUn",
                "Base Unit"
            ])),

            n(field(r, [
                "Unrestricted",
                "Unrestricted Qty"
            ])),

            s(field(r, [
                "Crcy",
                "Currency"
            ])),

            n(r["Value Unrestricted"])
        ]
    );

    write(
        "Adjusted MB52",
        adjustedHeaders,
        adjustedOutput
    );

    // =========================================================
    // SECTION 20: GENERATE MOVEMENT AUDIT
    // =========================================================

    write(
        "Movement Audit",
        [
            "Material + Batch",
            "Action",
            "Reason"
        ],
        audit
    );

    // =========================================================
    // SECTION 21: EXECUTION SUMMARY
    // =========================================================

    console.log(
        `Generated ${output.length} ageing rows; ` +
        `${audit.length} movement audit records`
    );
}
