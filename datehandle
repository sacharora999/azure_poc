
const dateSerial = (v: Cell | undefined): number => {
  if (typeof v === "number") {
    return Math.floor(v);
  }

  const s = clean(v);
  if (!s) throw new Error("Missing Net Due Date");

  let year: number;
  let month: number;
  let day: number;

  // Format: DD/MM/YYYY or DD-MM-YYYY
  const dmy = /^(\d{1,2})[/-](\d{1,2})[/-](\d{4})$/.exec(s);

  // Format: YYYY-MM-DD
  const ymd = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(s);

  if (dmy) {
    day = Number(dmy[1]);
    month = Number(dmy[2]);
    year = Number(dmy[3]);
  } else if (ymd) {
    year = Number(ymd[1]);
    month = Number(ymd[2]);
    day = Number(ymd[3]);
  } else {
    throw new Error("Unsupported Net Due Date: " + s);
  }

  const dt = new Date(Date.UTC(year, month - 1, day));

  if (
    dt.getUTCFullYear() !== year ||
    dt.getUTCMonth() + 1 !== month ||
    dt.getUTCDate() !== day
  ) {
    throw new Error("Invalid Net Due Date: " + s);
  }

  return Math.floor(
    (dt.getTime() - Date.UTC(1899, 11, 30)) / 86400000
  );
};
