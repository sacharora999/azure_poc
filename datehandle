
const dateSerial = (v: Cell | undefined): number => {
  if (typeof v === "number") {
    if (!Number.isFinite(v)) {
      throw new Error("Invalid Excel date serial");
    }
    return Math.floor(v);
  }

  const s = String(v ?? "").trim();

  if (!s) {
    throw new Error("Missing Net Due Date");
  }

  if (/^\d+(\.\d+)?$/.test(s)) {
    return Math.floor(Number(s));
  }

  let year: number;
  let month: number;
  let day: number;

  const iso = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(s);
  const dmy = /^(\d{1,2})[./-](\d{1,2})[./-](\d{4})$/.exec(s);

  if (iso) {
    year = Number(iso[1]);
    month = Number(iso[2]);
    day = Number(iso[3]);
  } else if (dmy) {
    day = Number(dmy[1]);
    month = Number(dmy[2]);
    year = Number(dmy[3]);
  } else {
    throw new Error("Unsupported Net Due Date: " + s);
  }

  const utc = Date.UTC(year, month - 1, day);
  const check = new Date(utc);

  if (
    check.getUTCFullYear() !== year ||
    check.getUTCMonth() !== month - 1 ||
    check.getUTCDate() !== day
  ) {
    throw new Error("Invalid Net Due Date: " + s);
  }

  return Math.floor(
    (utc - Date.UTC(1899, 11, 30)) / 86400000
  );
};
